# Copy file này thành .env.local và điền giá trị từ Supabase Dashboard → Project Settings → API Keys
# Local: dùng giá trị từ `npx supabase status`.
# KHÔNG điền key thật vào file này — file này được commit lên git.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only (KHÔNG thêm tiền tố NEXT_PUBLIC_). Dùng để admin tạo/khoá tài khoản thành viên.
SUPABASE_SECRET_KEY=sb_secret_xxx
