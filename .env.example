# Copy file này thành .env.local và điền giá trị từ Supabase Dashboard → Project Settings → API Keys
# Local: dùng giá trị từ `npx supabase status`.
# KHÔNG điền key thật vào file này — file này được commit lên git.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only (KHÔNG thêm tiền tố NEXT_PUBLIC_). Dùng để admin tạo/khoá tài khoản thành viên.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Zalo OA (tuỳ chọn; tất cả là server-only, KHÔNG thêm tiền tố NEXT_PUBLIC_) ---
# Bỏ trống cả nhóm nếu chưa dùng Zalo: ứng dụng vẫn chạy, thông báo chỉ hiện trong app.
# Lấy ở developers.zalo.me → ứng dụng của bạn.
ZALO_APP_ID=2956260614023015061
ZALO_APP_SECRET=Bb1EGG0LS4e5ZJ1DnoLP
# "OA Secret Key" ở trang Webhook của ứng dụng (dùng để kiểm tra chữ ký webhook).
ZALO_OA_SECRET_KEY=
# Địa chỉ công khai của ứng dụng (không có dấu / cuối), ví dụ https://todolist-indol-phi.vercel.app
APP_URL=https://todolist-indol-phi.vercel.app
# Chuỗi ngẫu nhiên ≥ 16 ký tự: pg_cron dùng để gọi bộ gửi Zalo. Tạo bằng: openssl rand -hex 32
CRON_SECRET=3f9a1c7e5b2d4086a1f3c5e7092b4d6f8a0c2e4165b7d9f1a3c5e7092b4d6f80adef
# Mã xác thực domain của Zalo (nội dung thẻ meta zalo-platform-site-verification), nếu Zalo yêu cầu.
ZALO_SITE_VERIFICATION=
